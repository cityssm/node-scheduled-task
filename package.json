{
  "name": "@cityssm/scheduled-task",
  "version": "0.3.0",
  "description": "Schedules recurring tasks while managing on-demand executions and limiting simultaneous executions.",
  "keywords": [
    "async",
    "child-process",
    "cron",
    "schedule",
    "task"
  ],
  "homepage": "https://github.com/cityssm/node-scheduled-task#readme",
  "bugs": {
    "url": "https://github.com/cityssm/node-scheduled-task/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cityssm/node-scheduled-task.git"
  },
  "license": "MIT",
  "author": "The Corporation of the City of Sault Ste. Marie",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./debug": "./debug.config.js"
  },
  "files": [
    "debug.config.*",
    "errors.*",
    "index.*"
  ],
  "scripts": {
    "coverage": "c8 --reporter=lcov --reporter=text --reporter=text-summary node --env-file=\".test.env\" --test",
    "test": "node --env-file=\".test.env\" --test"
  },
  "dependencies": {
    "async-sema": "^3.1.1",
    "camelcase": "^10.0.0",
    "exit-hook": "^5.1.0",
    "node-schedule": "^2.1.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/node-schedule": "^2.1.8",
    "eslint-config-cityssm": "^59.0.1",
    "prettier-config-cityssm": "^2.2.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
